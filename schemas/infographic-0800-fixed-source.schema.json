{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-bound fixed 08:00 infographic input",
  "type": "object",
  "required": [
    "report_id",
    "report_datetime",
    "revision",
    "title",
    "source_type",
    "source_document_id",
    "source_snapshot_id",
    "source_snapshot_identity",
    "market_data_snapshot",
    "body_text",
    "body_hash",
    "sections",
    "structured_facts",
    "numeric_registry",
    "numeric_registry_prevalidation",
    "source_numeric_registry_sha256",
    "source_numeric_registry"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}_08-00$"
    },
    "report_datetime": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T08:00(:00)?([+-]\\d{2}:?\\d{2}|Z)$"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "headline": {
      "type": "string"
    },
    "source_type": {
      "enum": [
        "GOOGLE_DOCS",
        "SYNTHETIC_FIXTURE"
      ]
    },
    "source_document_id": {
      "type": "string",
      "minLength": 1
    },
    "source_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "source_snapshot_identity": {
      "type": "object",
      "required": [
        "method",
        "source_document_id",
        "revision",
        "body_hash"
      ],
      "properties": {
        "method": {
          "const": "SHA256_CANONICAL_SOURCE_ID_REVISION_BODY_HASH"
        },
        "source_document_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "body_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "market_data_snapshot": {
      "$ref": "market-data-snapshot.schema.json"
    },
    "numeric_registry_prevalidation": {
      "type": "object",
      "required": [
        "status",
        "body_hash",
        "source_numeric_registry_sha256",
        "source_registry_count"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "body_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_numeric_registry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_registry_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "source_numeric_registry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_numeric_registry": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "source_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_persisted_after_report_time": {
      "type": "boolean"
    },
    "previous_close_table_rows": {
      "type": "integer",
      "minimum": 0
    },
    "source_selection": {
      "type": "object",
      "required": [
        "source",
        "source_order",
        "body_preserved_exactly",
        "fallbacks_used"
      ],
      "properties": {
        "source": {
          "const": "GOOGLE_DOCS"
        },
        "source_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "body_preserved_exactly": {
          "type": "boolean"
        },
        "fallbacks_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "body_text": {
      "type": "string",
      "minLength": 1
    },
    "body_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sections": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "fact_ids"
        ],
        "properties": {
          "section_id": {
            "type": "string"
          },
          "fact_ids": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "structured_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fact_id",
          "section_id",
          "text",
          "source_excerpt"
        ],
        "properties": {
          "fact_id": {
            "type": "string"
          },
          "section_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "source_excerpt": {
            "type": "string"
          },
          "importance": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "NORMAL"
            ]
          },
          "numeric_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fields": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "numeric_registry": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "numeric_id",
          "source_numeric_id",
          "fact_id",
          "value",
          "unit",
          "as_of",
          "source_excerpt",
          "as_of_source_excerpt"
        ],
        "properties": {
          "numeric_id": {
            "type": "string"
          },
          "source_numeric_id": {
            "type": "string"
          },
          "fact_id": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          },
          "unit": {
            "type": "string"
          },
          "as_of": {
            "type": "string"
          },
          "source_excerpt": {
            "type": "string"
          },
          "as_of_source_excerpt": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "synthetic_fixture": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
