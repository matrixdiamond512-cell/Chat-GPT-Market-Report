  "latestReport": {
    "date": "2026-09-25",
    "time": "16:00",
    "title": "マーケットレポート｜2026/09/25（金）16:00",
    "updatedAt": "2026-09-25T16:00:00+09:00",
    "revision": 1,
    "revisionNote": "原文全文と同一時間帯の既存Google Drive図解を復旧。",
    "sourceDocument": {
