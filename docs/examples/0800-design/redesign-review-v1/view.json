  "facts": [
    {
      "id": "f001",
      "text": "合成シナリオ：株式の反発と原油・金利の綱引きを検証する",
      "source_section": "今日の相場テーマ",
      "start": 95,
      "end": 122
    },
    {
      "id": "f002",
      "text": "株式は反発、警戒は継続",
      "source_section": "総合判断",
      "start": 32,
      "end": 43
    },
    {
      "id": "f003",
      "text": "これは描画試験用の架空データです。実市場の判断には使用できません。",
      "source_section": "総合判断",
      "start": 44,
      "end": 77
    },
    {
      "id": "f004",
      "text": "中立〜やや強気",
      "source_section": "総合判断",
      "start": 78,
      "end": 85
    },
    {
      "id": "f005",
      "text": "先物の基準値と出来高",
      "source_section": "今日の主導市場",
      "start": 432,
      "end": 442
    },
    {
      "id": "f006",
      "text": "原油とインフレ期待",
      "source_section": "今日の主導市場",
      "start": 443,
