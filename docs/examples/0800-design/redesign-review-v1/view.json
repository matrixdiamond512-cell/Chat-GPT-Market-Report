    },
    {
      "id": "f007",
      "text": "金利・為替の同時方向",
      "source_section": "今日の主導市場",
      "start": 453,
      "end": 463
    },
    {
      "id": "f008",
      "text": "株式・暗号資産の強弱差",
      "source_section": "今日の主導市場",
      "start": 464,
      "end": 475
    },
    {
      "id": "f009",
      "text": "リスク回復とインフレ警戒が併存。値動きだけで資金移動を断定しない。",
      "source_section": "今日の相場テーマ",
      "start": 123,
      "end": 156
    },
    {
      "id": "f010",
      "text": "材料と価格反応を区別し、原油から株式への影響を想定経路として監視する。",
      "source_section": "材料と値動きの整合性",
      "start": 388,
      "end": 423
    },
    {
      "id": "f011",
      "text": "WTI 95.55ドル超を警戒",
      "source_section": "シナリオが崩れる条件",
      "start": 1808,
      "end": 1823
    },
    {
      "id": "f012",
      "text": "米長期金利の再上昇を警戒",
      "source_section": "シナリオが崩れる条件",
      "start": 1824,
      "end": 1836
    },
    {
